# Copy to .env and fill in. Never commit .env.
# Supabase (server-side only; the browser never talks to Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# OpenRouter (optional; without it the app runs fully offline)
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_ESCALATION_MODEL=
LLM_DEADLINE_S=5.0
LLM_MAX_RETRIES=0
LLM_BUDGET_USD=3.0
# App
STORE=auto
OFFLINE=0
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
