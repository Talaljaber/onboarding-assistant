# Copy to .env and fill in. Never commit .env. Every variable is optional; the defaults are shown.
# A bad value stops the app at startup with a one-line fix (tests/test_hardening.py checks this list).

# Supabase (server-side only; the browser never talks to Supabase). Empty = local SQLite store.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# OpenRouter (optional; without it the app runs fully offline)
OPENROUTER_API_KEY=
# Pinned "vendor/model" ids only; openrouter/auto (auto-routing) is rejected at startup.
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Escalation model of the answer panel (reasoning on); empty = no escalation.
LLM_ESCALATION_MODEL=z-ai/glm-5.3
# Answer panel (1 = on): sanitizer + answerer + two judges on the pinned model, escalation when not confident.
LLM_PANEL=1
# Panel acceptance threshold on the judges' minimum confidence (picked on DEV).
LLM_PANEL_ACCEPT=0.7
# Rumour Check model layer (1 = on, the default; it passed scripts/eval_factcheck.py with 0 false `supported`); 0 = offline rules.
LLM_CHECK=1
# Seconds: whole-turn LLM deadline, and the share for the tool-choice call.
LLM_DEADLINE_S=5.0
LLM_AGENT_DEADLINE_S=1.5
LLM_MAX_RETRIES=0
# Hard spending cap across all runs (USD); at the cap the app switches to offline mode.
LLM_BUDGET_USD=3.0
# Verified-reply cache and spend ledger (relative paths are under the app folder).
LLM_CACHE_PATH=.cache/llm.sqlite
LLM_BUDGET_PATH=.cache/budget.json

# Data and model folders (relative paths are under the app folder)
ENCODER_DIR=models/e5
DATA_OFFICIAL=data/official
DATA_OURS=data/ours
DATA_LIVE=data/live

# App
# auto = Supabase when configured and reachable, else local; local = always SQLite.
STORE=auto
# 1 = never call the LLM (also ignores the key).
OFFLINE=0
LOG_LEVEL=INFO
# Admin sign-in for the knowledge editor and the manager view (4-64 characters).
# Empty = the demo password written in the README; set your own for anything beyond a demo.
ADMIN_PASSWORD=
# Hours an admin stays signed in (a server restart also signs the admin out).
ADMIN_SESSION_HOURS=8
HOST=127.0.0.1
PORT=8000

# Email notifications (P18.2; optional). Empty SMTP_USER or SMTP_PASSWORD = no email is sent (each event is
# recorded as "skipped" in the admin's email log); OFFLINE=1 never sends either.
# Gmail: turn on 2-Step Verification (Google Account -> Security -> 2-Step Verification), then create an app
# password under Security -> 2-Step Verification -> App passwords and paste its 16 letters below (the spaces
# Google shows are removed). Your normal Gmail password does not work. The password is never logged or shown.
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (SSL from the first byte); 587 (or any other port) = STARTTLS. Gmail supports both.
SMTP_PORT=587
# The Gmail address that sends the emails.
SMTP_USER=
SMTP_PASSWORD=
# The From address; empty = SMTP_USER.
MAIL_FROM=
# Where intern-side events go (intern replies, requests marked done, questions sent) and the test email.
ADMIN_EMAIL=
# Deadline reminders (P21.1): the intern gets an email this many minutes before a request's deadline (1-120).
# Sent only when email is set up above and OFFLINE is not 1; a reminder missed while the server was down is not sent.
REMINDER_MINUTES=10

# Hosting (P24.1): other sites allowed to send writes, comma-separated, e.g. a Netlify front end that
# forwards /api/* to this server (https://dada-academy.netlify.app). Empty = same origin only.
ALLOWED_ORIGINS=

# start.bat only (not read by the app): DADA_PYTHON (interpreter override), NOPAUSE=1, NOBROWSER=1.
